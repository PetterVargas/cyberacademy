# Crea una app en https://unsplash.com/developers para obtener tu Access Key.
# En producción (Cloudflare Pages) este valor vive en el proyecto de Pages > Settings > Environment
# variables, como variable "Secret".
UNSPLASH_ACCESS_KEY=

# ID de la colección: https://unsplash.com/collections/STX3OtAI8tM/cover-divisioncero
# En producción (Cloudflare Pages) este valor vive en wrangler.jsonc > vars, no en el dashboard
# (Cloudflare usa wrangler.jsonc como fuente de verdad para las vars de texto cuando el archivo existe).
UNSPLASH_COLLECTION_ID=STX3OtAI8tM
