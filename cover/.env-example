# Crea una app en https://unsplash.com/developers para obtener tu Access Key.
# En producción (Cloudflare Pages) este valor vive en el proyecto de Pages > Build > Variables and
# secrets, como tipo "Secret". No lo declares en wrangler.jsonc.
UNSPLASH_ACCESS_KEY=

# ID de la colección: https://unsplash.com/collections/STX3OtAI8tM/cover-divisioncero
# En producción (Cloudflare Pages) este valor vive en el mismo panel, Build > Variables and secrets,
# como tipo "Plaintext". No lo declares en wrangler.jsonc.
UNSPLASH_COLLECTION_ID=STX3OtAI8tM
