{
  "name": "cover",
  "type": "module",
  "private": true,
  "scripts": {
    "fetch": "tsx scripts/fetch.ts",
    "process": "tsx scripts/process.ts",
    "update": "pnpm run fetch && pnpm run process",
    "typecheck": "tsc --noEmit",
    "dev": "pnpm run update && wrangler pages dev public",
    "deploy": "wrangler pages deploy public --project-name=cover-divisioncero"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "ofetch": "^1.5.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.0"
  }
}
